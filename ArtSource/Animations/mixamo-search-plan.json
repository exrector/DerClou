{
  "schemaVersion": 1,
  "provider": "Adobe Mixamo",
  "acquisitionTool": "ArtSource/Tools/mixamo_selective_download.py",
  "policy": {
    "downloadMode": "motion-only",
    "fps": 30,
    "keyframeReduction": false,
    "bulkArchive": false,
    "rawRedistribution": false,
    "acceptance": "Every candidate must pass audit_action_fbx.py, visual preview and semantic review before apply_animation.py."
  },
  "requiredSearches": [
    { "semantic": "StopWalking", "queries": ["stop walking", "walking stop"] },
    { "semantic": "ShortStep", "queries": ["step forward", "small step"] },
    { "semantic": "TurnLeft", "queries": ["left turn", "turn left"] },
    { "semantic": "TurnRight", "queries": ["right turn", "turn right"] },
    { "semantic": "TurnAround", "queries": ["turn around", "180 turn"] },
    { "semantic": "CloseDoor", "queries": ["close door", "closing door"] },
    { "semantic": "UnlockDoor", "queries": ["unlock", "use key"] },
    { "semantic": "Lockpick", "queries": ["lockpick", "picking lock"] }
  ]
}
